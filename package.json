{
  "name": "ai-a11y",
  "version": "0.0.0",
  "description": "AI chat answers that screen readers can follow.",
  "type": "module",
  "license": "MIT",
  "author": "Helder Berto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helderberto/ai-a11y.git"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "aria-live",
    "screen-reader",
    "ai",
    "llm",
    "streaming",
    "chat",
    "react"
  ],
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26.13.0"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "lint:package": "pnpm build && publint --strict",
    "test": "vitest run --coverage",
    "test:colocated": "node scripts/check-colocated-tests.ts",
    "test:circular": "dpdm --no-tree --no-warning --exit-code circular:1 --tsconfig tsconfig.json \"src/**/*.{ts,tsx}\"",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:colocated && pnpm test:circular && pnpm test && pnpm lint:package",
    "prepare": "husky"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.28",
    "dpdm": "4.3.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-dts": "5.1.2",
    "vitest": "5.0.5"
  }
}
